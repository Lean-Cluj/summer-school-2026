/-- `add_ten` succeeds whenever `x + 10` does not overflow `U32`, and on
    success it returns exactly `x + 10`. -/
theorem add_ten.spec (x : Std.U32) (h : x.val + 10 ≤ Std.U32.max) :
    add_ten x ⦃ res => res.val = x.val + 10 ⦄ := by
  unfold add_ten
  step as ⟨ res, hres ⟩
  exact hres

/-!
The second theorem has the hypothesis form: whenever `add_ten x` is `ok y`, the
value of `y` is `x.val + 10`. It needs no precondition, and it states nothing
about the inputs for which `add_ten` fails.

The library lemma `UScalar.add_equiv x y` describes the outcomes of `x + y`, for
unsigned machine integers of any width, by a `match` on the three constructors
of `Result`:

* if `x + y` is `ok z`, then three facts hold: `x.val + y.val < 2 ^ ty.numBits`,
  where `ty.numBits` is the number of bits, here `32`; `z.val = x.val + y.val`;
  and `z.bv = x.bv + y.bv`, the same equation for the bit vectors;
* if `x + y` is `fail e`, then the sum is out of bounds;
* if `x + y` is `div`, the lemma gives the proposition `⊥`, which is `False`,
  so this case does not occur. The result `div` arises only from computations
  that may not terminate, such as loops, and an addition always terminates.
  The function `add_ten` contains no loop and no recursive call, so it is never
  `div` either.

After `unfold add_ten at h`, the hypothesis is `h : x + 10#u32 = ok y`.
Rewriting with it turns the argument of the `match` into `ok y`. The pattern of
`obtain` then reduces the `match` to its first case and takes out the second
fact. In the pattern `⟨-, hval, -⟩`, the symbol `-` drops
the first and the third fact from the context.
-/

/-- Hypothesis form: whenever `add_ten` succeeds, the result is exactly the
    mathematical sum (no silent wraparound). -/
theorem add_ten.spec' (x y : Std.U32) (h : add_ten x = ok y) :
    y.val = x.val + 10 := by
  unfold add_ten at h
  have he := UScalar.add_equiv x (10#u32)
  rw [h] at he
  obtain ⟨-, hval, -⟩ := he
  exact hval

/-!
The third theorem states when the function fails: if `x.val + 10` exceeds
`Std.U32.max`, then `add_ten x` is not `ok y` for any `y`. The tactic
`scalar_tac` proves arithmetic goals about machine integers. It adds the bounds
of the machine integers in the context as hypotheses, such as
`x.val ≤ Std.U32.max`, simplifies the goal and the hypotheses, and finishes
with `omega`.
-/

/-- `add_ten` fails when the addition would overflow `U32`: there is then no
    `y` with `add_ten x = ok y`. -/
theorem add_ten.spec_overflow (x : Std.U32) (h : Std.U32.max < x.val + 10) :
    ¬ ∃ y, add_ten x = ok y := by
  unfold add_ten
  rintro ⟨y, hy⟩
  have he := UScalar.add_equiv x (10#u32)
  rw [hy] at he
  scalar_tac

end add_ten
