/-!
## The value of the constant

The constant `PRIME` is irreducible, so no tactic unfolds it by itself. The
theorem `PRIME_val` states its value once, as `MAX_ERROR_CODE_val` does in
`ErrorCodes_verified.lean`.
-/

theorem PRIME_val : PRIME.val = 2147483647 := by
  simp only [global_simps]; scalar_tac

/-!
## The specification

The preconditions `a.value.val < PRIME.val` and `b.value.val < PRIME.val` state
that both arguments are reduced modulo `p`. Under them, `add_m31` succeeds, its
result is the sum modulo `p`, and the result is again reduced. The last part
follows from the second, since a remainder modulo `p` is less than `p`; it is
stated separately because it is what a caller of `add_m31` needs.

In the proof, `have hp := PRIME_val` brings the value of `PRIME` into the
context. Then `step as ⟨ sum, hsum_post ⟩` handles the addition: it proves the
precondition that excludes overflow from `ha`, `hb` and `hp`, and introduces the
sum with its postcondition. Then `split` distinguishes the two branches of the
`if`. In the first branch, a second `step` handles the subtraction, whose
precondition `PRIME.val ≤ sum.val` follows from the condition of the branch.
The two library lemmas `Nat.mod_eq_sub_mod : a ≥ b → a % b = (a - b) % b` and
`Nat.mod_eq_of_lt : a < b → a % b = a` of Lean core compute the remainders.
-/

/-- `add_m31` correctly computes addition modulo `PRIME`: it succeeds on
    well-formed field elements, the result equals the sum reduced modulo
    `PRIME`, and the result is itself a well-formed field element. -/
theorem add_m31.spec (a b : M31) (ha : a.value.val < PRIME.val) (hb : b.value.val < PRIME.val) :
    add_m31 a b ⦃ res =>
      res.value.val = (a.value.val + b.value.val) % PRIME.val ∧
      res.value.val < PRIME.val ⦄ := by
  unfold add_m31
  have hp := PRIME_val
  step as ⟨ sum, hsum_post ⟩
  have h2 : sum.val = a.value.val + b.value.val := by scalar_tac
  split
  · step as ⟨ sum1, hsum1_post ⟩
    have h1 : sum1.val = sum.val - PRIME.val := by scalar_tac
    have h3 : PRIME.val ≤ sum.val := by scalar_tac
    refine ⟨?_, by scalar_tac⟩
    rw [h1, ← h2, Nat.mod_eq_sub_mod h3, Nat.mod_eq_of_lt (by scalar_tac)]
  · refine ⟨?_, by scalar_tac⟩
    change sum.val = (a.value.val + b.value.val) % PRIME.val
    rw [h2, Nat.mod_eq_of_lt (by scalar_tac)]

end mersenne31
