/-!
## The value of the constant

The tactic `simp only [global_simps]` uses the equation added by the attribute
`global_simps` to replace `MAX_ERROR_CODE` by `4095#i32`, which leaves the goal
`(4095#i32).val = 4095`. The tactic `scalar_tac` proves it.
-/

theorem MAX_ERROR_CODE_val : MAX_ERROR_CODE.val = 4095 := by
  simp only [global_simps]; scalar_tac

/-!
## The specification of `from_code`

The postcondition is a `match` on the inner result. In the case `Ok ec`, the
code lies between `1` and `MAX_ERROR_CODE`, and `ec` stores it unchanged. In the
case `Err ()`, the code lies outside that range. The function never panics, so
the specification has no precondition.

The proof follows the two `if`s with `split`. In each case, `scalar_tac` proves
the inequalities from the condition of the branch and `hp`, and `rfl` proves
`ec.value = code`.
-/

/-- `from_code` returns `Ok` for the codes in `(0, MAX_ERROR_CODE]` and `Err` for
    the others, and in the case `Ok` the constructed `ErrorCode` stores the
    code unchanged. -/
theorem ErrorCode.from_code.spec (code : Std.I32) :
    ErrorCode.from_code code ⦃ res =>
      match res with
      | core.result.Result.Ok ec =>
        0 < code.val ∧ code.val ≤ MAX_ERROR_CODE.val ∧ ec.value = code
      | core.result.Result.Err () =>
        code.val ≤ 0 ∨ MAX_ERROR_CODE.val < code.val ⦄ := by
  unfold ErrorCode.from_code
  have hp := MAX_ERROR_CODE_val
  split
  · exact Or.inl (by scalar_tac)
  · split
    · exact Or.inr (by scalar_tac)
    · exact ⟨by scalar_tac, by scalar_tac, rfl⟩

/-!
## The specification of `to_code`

The simp lemma `WP.spec_ok` rewrites `ok v ⦃ res => P res ⦄` to `P v`, so
`simp` proves the specification after unfolding `to_code`.
-/

/-- `to_code` always succeeds and returns the code stored in the `ErrorCode`.
    That it inverts a successful `from_code` is `from_code_to_code` below. -/
theorem ErrorCode.to_code.spec (self : ErrorCode) :
    ErrorCode.to_code self ⦃ res => res = self.value ⦄ := by
  simp [ErrorCode.to_code]

/-!
## The invariant

The last theorem combines the two specifications: if `from_code code` returns
`ok (Ok ec)`, then `ec` satisfies the invariant, and `to_code ec` returns
`code`. The proof rewrites the specification of `from_code` with `h` and
`WP.spec_ok`, and `obtain` takes out the three facts of the case `Ok ec`. The
lemma `WP.spec_imp_exists` turns the specification of `to_code` into its
existential form, which gives `hto : ErrorCode.to_code ec = ok y`.
-/

/-- Putting the two specs together: whenever `from_code` succeeds, the
    resulting `ErrorCode` satisfies its invariant (`0 < value ≤
    MAX_ERROR_CODE`) and round-trips through `to_code` back to the original
    code. -/
theorem ErrorCode.from_code_to_code
    (code : Std.I32) (ec : ErrorCode)
    (h : ErrorCode.from_code code = ok (core.result.Result.Ok ec)) :
    0 < ec.value.val ∧ ec.value.val ≤ MAX_ERROR_CODE.val ∧
    ErrorCode.to_code ec = ok code := by
  have hspec := ErrorCode.from_code.spec code
  rw [h, WP.spec_ok] at hspec
  obtain ⟨hpos, hmax, heq⟩ := hspec
  subst heq
  obtain ⟨y, hto, hyeq⟩ := WP.spec_imp_exists (ErrorCode.to_code.spec ec)
  refine ⟨hpos, hmax, ?_⟩
  rw [hto, hyeq]

